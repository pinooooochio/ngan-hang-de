\documentclass[12pt]{article}
\usepackage{nhd}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\small << d.title | tex >> \quad Trang \thepage/\pageref{LastPage}}
<% macro question(q, solutions) %>
% @@CAU << q.code >>
<< q.stem >>
<% if q.type == "mcq" %>
\luachon[<< q.correct_index if solutions else 0 >>]<% for c in q.choices %>{<< c.content >>}<% endfor %>
<% elif q.type == "tf" %>
<% for c in q.choices %>
\menhde{<< "abcd"[loop.index0] >>}{<< c.content >>}{<% if solutions %><< "Đúng" if c.correct else "Sai" >><% endif %>}
<% endfor %>
<% endif %>
<% if solutions %>
<% if q.type == "short" %>\dapanngan{<< q.short_answer >>}<% endif %>
<% if q.solution %>\begin{loigiai}
<< q.solution >>
\end{loigiai}<% endif %>
<% endif %>
<% endmacro %>
<% macro block(b) %>
<% if b.question %>
\begin{vidu}
<< question(b.question, true) >>
\end{vidu}
<% elif b.kind == "doan" %>
<< b.content >>
\par
<% else %>
\begin{<< b.kind >>}<% if b.title %>[<< b.title >>]<% endif %>

<< b.content >>
\end{<< b.kind >>}
<% endif %>
<% endmacro %>

\begin{document}

\begin{center}
  {\LARGE\bfseries << d.title | tex >>}\par\smallskip
  << date_text >>
\end{center}
\hrule\medskip

<% for t in d.topics %>
\chude{<< t.ten | tex >>}
<% if t.general %>
\muc{Kiến thức cần nhớ}
<% for b in t.general %>
<< block(b) >>
<% endfor %>
<% endif %>
<% for g in t.dang %>
\dangbai{Dạng << loop.index >>. << g.name | tex >>}
<% for b in g.theory %>
<< block(b) >>
<% endfor %>
<% if g.exercises %>
\muc{Bài tập tự luyện}
<% for q in g.exercises %>
\causo{<< q.number >>}<< question(q, false) >>
<% endfor %>
<% endif %>
<% endfor %>
<% if t.mixed %>
\dangbai{Bài tập tổng hợp}
<% for q in t.mixed %>
\causo{<< q.number >>}<< question(q, false) >>
<% endfor %>
<% endif %>
<% endfor %>

<% if exercises %>
\clearpage
\chude{Đáp án và lời giải}
<% if has_key %>
\muc{Bảng đáp án}
<% for row in exercises | batch(10) %>
\noindent\begin{tabular}{|>{\bfseries}l|<% for _ in row %>c|<% endfor %>}
\hline
Câu<% for q in row %> & << q.number >><% endfor %> \\ \hline
Đáp án<% for q in row %> & << (q.key | tex) if q.type != "essay" else "TL" >><% endfor %> \\ \hline
\end{tabular}\par\smallskip
<% endfor %>
<% endif %>
\muc{Lời giải chi tiết}
<% for q in exercises %>
\causo{<< q.number >>}<% if q.type != "essay" %>{\bfseries\color{nhddung}Đáp án: << q.key | tex >>.}<% endif %>

<% if q.solution %>
% @@CAU << q.code >>
<< q.solution >>
<% else %>
{\itshape (Chưa có lời giải.)}
<% endif %>
\par
<% endfor %>
<% endif %>
\end{document}
